# DriverManagement — Environment variables (example)
# Copy this file to .env (or .env.postgres) and fill in real values.
# Never commit a file with secrets. The file is loaded automatically by
# backend/config/settings.py; real environment variables take precedence.

# ---------------------------------------------------------------
# Django
# ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-strong-random-secret
DJANGO_DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------
# Database — PostgreSQL is the primary database
# ---------------------------------------------------------------
# DATABASE_URL=postgres://dbuser:dbpassword@dbhost:5432/dbname
# Or use the individual variables (DATABASE_URL components win if both are set):
# DB_NAME=drivermanagement
# DB_USER=dbuser
# DB_PASSWORD=dbpassword
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# SQLite is an explicit opt-in only (offline tooling / emergency fallback):
# DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3

# ---------------------------------------------------------------
# Storage (local disk, unchanged)
# ---------------------------------------------------------------
STORAGE_ROOT=/Users/macbook/Documents/Default Project/DriverManagement/storage
MEDIA_ROOT=${STORAGE_ROOT}/media
BACKUP_ROOT=/Users/macbook/Documents/Default Project/DriverManagement/backups
