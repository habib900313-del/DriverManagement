# Example only. Never put real credentials in this tracked file.
# Copy to .env for local development; these active values preserve the existing
# local run scripts. Production must use config.production_settings and a
# protected environment file outside the repository.

# Local development
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=local-development-only-not-a-production-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Production: use these keys in the protected VPS environment file after
# replacing placeholders; do not enable these by copying this sample as-is.
# DJANGO_SETTINGS_MODULE=config.production_settings
# DJANGO_SECRET_KEY=replace-with-a-generated-random-secret-at-least-50-characters
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=drivers.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://drivers.example.com
# DJANGO_HSTS_SECONDS=3600
# DB_NAME=drivermanagement
# DB_USER=driverapp
# DB_PASSWORD=replace-with-the-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=30

# Frontend: API base path used by the browser SPA (Vite injects VITE_* vars).
# Default '/api' works when Nginx proxies /api/ to Django on the same origin.
# VITE_API_BASE=/api

# Optional local database overrides:
# DATABASE_URL=postgres://dbuser:dbpassword@dbhost:5432/dbname
# DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3
